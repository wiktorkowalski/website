---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Unit from "../components/Unit.astro";
import { SITE, SOCIALS } from "../consts";
import { getPosts } from "../lib/posts";

// Placeholder rack: structure + content wiring. Final visuals come from the Claude Design pass.
const projects = (await getCollection("projects", (p) => !p.data.hidden)).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(projects.map(async (p) => ({ p, Content: (await render(p)).Content })));
const posts = await getPosts();
const stack = await getCollection("stack");
const cv = (await getCollection("cv")).map((e) => e.data);
const newest = (a: { from: string }, b: { from: string }) => b.from.localeCompare(a.from);
const jobs = cv.filter((e) => e.kind === "job").sort(newest);
const schools = cv.filter((e) => e.kind === "school").sort(newest);
const certs = cv.filter((e) => e.kind === "cert");
const span = (e: { from: string; to?: string }) =>
  e.to && e.to !== e.from ? `${e.from} → ${e.to}` : e.to ? e.from : `${e.from} → now`;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Base>
  <Unit id="whoami" label="KVM-01" u={2}>
    <h1 class="term">
      <span class="prompt" aria-hidden="true">
        $ whoami
      </span>
      <span>Wiktor Kowalski</span>
    </h1>
    <p>
      Software engineer working mostly with .NET, Node.js and AWS. I like the part of the job where code meets
      infrastructure: Terraform, CI pipelines, DNS, and the small tools that keep everything running.
    </p>
    <p>
      This page is my rack. Projects are the servers, the NAS holds my latest blog posts, and the log server
      below is my CV.
    </p>
  </Unit>

  <section id="projects" aria-labelledby="projects-h" class="group">
    <h2 id="projects-h" class="label">
      Servers · projects
    </h2>
    {rendered.map(({ p, Content }, i) => (
      <Unit label={`SRV-${String(i + 1).padStart(2, "0")}`} title={p.data.title} id={`srv-${p.id}`} u={2}>
        <p class="summary">{p.data.summary}</p>
        <div class="prose">
          <Content />
        </div>
        <ul class="tags">
          {p.data.stack.map((s) => (
            <li class="tag">{s}</li>
          ))}
          {p.data.status !== "active" && <li class="tag amber">{p.data.status}</li>}
        </ul>
        <p class="links">
          {p.data.url && <a href={p.data.url}>live</a>}
          {p.data.repo && <a href={p.data.repo}>source</a>}
        </p>
      </Unit>
    ))}
  </section>

  <Unit id="posts" label="NAS-01" title="Latest posts" u={2}>
    {posts.length > 0 && (
      <ol class="bays">
        {posts.map((post) => (
          <li>
            <span class="led" aria-hidden="true" />
            <a href={post.url}>{post.title}</a>
            <time class="label" datetime={post.date.toISOString()}>
              {fmt(post.date)}
            </time>
          </li>
        ))}
      </ol>
    )}
    <p>
      <a href={SITE.blog}>All posts on the blog →</a>
    </p>
  </Unit>

  <Unit id="stack" label="SW-01" title="Stack" u={1}>
    <dl class="ports">
      {stack.map((g) => (
        <div>
          <dt class="label">{g.id}</dt>
          <dd>
            <ul class="tags">
              {g.data.items.map((i) => (
                <li class="tag">{i}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </Unit>

  <Unit id="cv" label="LOG-01" title="CV" u={4}>
    <h3 class="label">experience</h3>
    <ol class="log">
      {jobs.map((j) => (
        <li>
          <span class="ts">{span(j)}</span>
          <div>
            <strong>{j.role}</strong> @ {j.company}
            {j.notes.length > 0 && (
              <ul>
                {j.notes.map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
    <h3 class="label">education</h3>
    <ol class="log">
      {schools.map((s) => (
        <li>
          <span class="ts">{span(s)}</span>
          <div>
            <strong>{s.degree}</strong>, {s.school}
          </div>
        </li>
      ))}
    </ol>
    <h3 class="label">certifications</h3>
    <ul class="tags">
      {certs.map((c) => (
        <li class="tag">{c.url ? <a href={c.url}>{c.name}</a> : c.name}</li>
      ))}
    </ul>
  </Unit>

  <Unit id="contact" label="UPS-01" title="Contact" u={2}>
    <p class="lcd">
      <span class="led amber" aria-hidden="true"></span> status: online, open to interesting problems
    </p>
    <p>The fastest way to reach me:</p>
    <ul class="tags">
      {SOCIALS.filter((s) => s.label === "LinkedIn" || s.label === "GitHub").map((s) => (
        <li>
          <a class="tag" href={s.href}>
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </Unit>
</Base>

<style>
  .term {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font: 700 1.75rem/1.2 var(--mono);
    margin: 0.5rem 0 1rem;
  }
  .prompt {
    font-size: 0.9rem;
    color: var(--led);
  }
  .group {
    margin: 2rem 0 0;
  }
  .group > h2 {
    margin: 0 0 0.75rem;
  }
  .summary {
    margin-top: 0;
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }
  .tag.amber {
    color: var(--amber);
    border-color: var(--amber);
  }
  .links {
    display: flex;
    gap: 1rem;
    font-family: var(--mono);
    margin-bottom: 0;
  }
  .bays,
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bays li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--edge);
  }
  .bays a {
    flex: 1;
  }
  .ports {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  .ports dd {
    margin: 0;
  }
  .ports .tags {
    margin: 0.35rem 0 0;
  }
  h3.label {
    margin: 1.5rem 0 0.5rem;
  }
  .log > li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 0.25rem 1rem;
    padding: 0.4rem 0;
  }
  .log ul {
    margin: 0.25rem 0 0;
    padding-left: 1.1rem;
    color: var(--muted);
  }
  .ts {
    font: 0.85rem/1.9 var(--mono);
    color: var(--amber);
  }
  @media (max-width: 34rem) {
    .log > li {
      grid-template-columns: 1fr;
    }
  }
  .lcd {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--mono);
    background: #0a1a10;
    border: 1px solid var(--edge);
    padding: 0.5rem 0.75rem;
    color: var(--led);
  }
</style>
