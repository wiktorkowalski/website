---
import Device from "./Device.astro";
import { NAV, SITE } from "../../consts";
---

<Device as="nav" label="Sections" oneU class="pp">
  <a href="/" class="brand">
    <span class="name">{SITE.title}</span>
    <span class="tag-dev">PATCH-01</span>
  </a>
  <ul>
    {NAV.map((p, i) => (
      <li>
        <a href={p.href} class="port">
          <span class="jack" aria-hidden="true">
            <span class="a" />
            <span class:list={["b", { act: p.act }]} />
          </span>
          <span>
            <span class="num">{String(i + 1).padStart(2, "0")}</span> {p.label}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Device>

<style>
  :global(.body.pp) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 16px;
    padding: 6px 4px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px;
    margin-right: 8px;
    text-decoration: none;
    color: var(--text);
  }
  .name {
    font: 700 15px/1.3 var(--mono);
    letter-spacing: 0.02em;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 4px;
    flex: 1 1 auto;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .port {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 8px;
    text-decoration: none;
    color: var(--text);
    font: 13px/1 var(--mono);
  }
  .port:hover .jack {
    border-color: var(--muted);
  }
  .num {
    color: var(--muted);
  }
  .jack {
    position: relative;
    width: 22px;
    height: 18px;
    flex: none;
    background: #08090b;
    border: 2px solid #4a525a;
    border-radius: 2px;
    box-sizing: border-box;
    box-shadow: inset 0 2px 3px #000;
  }
  .jack span {
    position: absolute;
    top: 2px;
    width: 4px;
    height: 3px;
    border-radius: 1px;
  }
  .a {
    left: 2px;
    background: var(--led);
    box-shadow: 0 0 4px var(--led);
  }
  .b {
    right: 2px;
    background: var(--led-off);
  }
  .b.act {
    background: var(--amber);
  }
</style>
