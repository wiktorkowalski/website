---
import { getCollection } from "astro:content";
import Device from "./Device.astro";

const ports = (await getCollection("stack")).flatMap((s) => s.data.items);
---

<Device id="stack" labelledby="stack-h" oneU dark class="sw">
  <div class="t">
    <h2 id="stack-h" class="h-dev">
      Stack
    </h2>
    <span class="tag-dev">SW-01</span>
  </div>
  <ul>
    {ports.map((name, i) => (
      <li>
        <span class="rj" aria-hidden="true">
          <i class="a" />
          <i class:list={["b", { act: i % 3 === 1 }]} />
        </span>
        <span class="n">{name}</span>
      </li>
    ))}
  </ul>
  <div class="sfp full-only" aria-hidden="true">
    <span></span>
    <span></span>
  </div>
</Device>

<style>
  :global(.body.sw) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 18px;
    padding: 10px 4px;
  }
  .t {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  ul {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 6px;
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 64px;
  }
  .rj {
    position: relative;
    width: 26px;
    height: 22px;
    background: #050607;
    border: 2px solid #3a4047;
    border-radius: 2px;
    box-sizing: border-box;
    box-shadow: inset 0 3px 4px #000;
  }
  .rj::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 7px;
    width: 8px;
    height: 4px;
    background: #3a4047;
  }
  .rj i {
    position: absolute;
    top: 2px;
    width: 4px;
    height: 3px;
    border-radius: 1px;
  }
  .a {
    left: 2px;
    background: var(--led);
    box-shadow: 0 0 4px var(--led);
  }
  .b {
    right: 2px;
    background: var(--led-off);
  }
  .b.act {
    background: var(--amber);
  }
  .n {
    font: 12px/1.3 var(--mono);
    color: var(--text);
  }
  .sfp {
    display: flex;
    gap: 4px;
  }
  .sfp span {
    width: 34px;
    height: 16px;
    background: #050607;
    border: 2px solid #4a525a;
    border-radius: 1px;
  }
</style>
