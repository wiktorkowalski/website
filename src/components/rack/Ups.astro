---
import Device from "./Device.astro";
import { SITE, STATUS } from "../../consts";
---

<Device id="contact" labelledby="contact-h" dark class="ups">
  <div class="t">
    <h2 id="contact-h" class="h-dev">
      Contact
    </h2>
    <span class="tag-dev">UPS-01</span>
  </div>
  <div class="lcd">
    <span class="k">STATUS</span>
    <span class="v">{STATUS.headline}</span>
    <span class="d">{STATUS.detail}</span>
  </div>
  <div class="cta">
    <a href={`mailto:${SITE.email}`} class="mail">
      <svg
        aria-hidden="true"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3 7l9 6 9-6" />
      </svg>
      {SITE.email}
    </a>
  </div>
  <span class="ind" aria-hidden="true">
    <span>
      <i class="dot"></i>LINE
    </span>
    <span>
      <i class="dot off"></i>BATT
    </span>
    <span>
      <i class="dot off"></i>FAULT
    </span>
  </span>
</Device>

<style>
  :global(.body.ups) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 22px;
  }
  .t {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .lcd {
    flex: 1 1 280px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px;
    background: #171003;
    border: 4px solid #0a0b0c;
    border-radius: 4px;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.85);
    font-family: var(--mono);
    color: var(--amber);
  }
  .k {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: #d9952a;
  }
  .v {
    font-size: 20px;
    font-weight: 700;
  }
  .d {
    font-size: 12px;
    color: #e8b25c;
  }
  .cta {
    flex: 1 1 240px;
    min-width: 0;
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    max-width: 100%;
    padding: 0 18px;
    border-radius: 3px;
    background: var(--led);
    color: #04130a;
    text-decoration: none;
    font: 700 14px/1.2 var(--mono);
    overflow-wrap: anywhere;
    box-shadow:
      0 0 0 1px #000,
      0 0 18px rgba(61, 220, 132, 0.25);
  }
  .mail:hover {
    color: #04130a;
    background: #5ff0a0;
  }
  .ind .dot {
    width: 7px;
    height: 7px;
  }
</style>
