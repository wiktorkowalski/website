---
// One rack device. `u` = height in rack units, only used for the label.
interface Props {
  id?: string;
  label: string;
  title?: string;
  u?: number;
}
const { id, label, title, u = 1 } = Astro.props;
---

<section id={id} class="unit dev" aria-labelledby={title && id ? `${id}-h` : undefined}>
  <div class="dev-head">
    <span class="led" aria-hidden="true"></span>
    <span class="label">{label}</span>
    <span class="label u">{u}U</span>
  </div>
  {title && <h2 id={id ? `${id}-h` : undefined}>{title}</h2>}
  <slot />
</section>

<style>
  .dev {
    margin: 0 0 1.25rem;
    padding-top: 1rem;
    padding-bottom: 1.25rem;
    scroll-margin-top: 1rem;
  }
  .dev-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }
  .u {
    margin-left: auto;
  }
  h2 {
    font: 700 1.25rem/1.3 var(--mono);
    margin: 0 0 1rem;
  }
</style>
