{
  "name": "website",
  "main": "./worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // www needs the redirect in worker.js, so the Worker runs before assets.
    "run_worker_first": true,
  },
  // DNS records (AAAA 100::, proxied) live in cloudflare-terraform.
  "routes": [
    { "pattern": "wiktorkowalski.pl/*", "zone_name": "wiktorkowalski.pl" },
    { "pattern": "www.wiktorkowalski.pl/*", "zone_name": "wiktorkowalski.pl" },
  ],
}
